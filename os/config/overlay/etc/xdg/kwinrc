# Huginn OS: KWin's defaults for the Huginn session.
[Plugins]
# Tells Huginn's top bar which app is in front (/usr/share/kwin-wayland/scripts/huginnactive).
huginnactiveEnabled=true
# Window animations: opening and closing (Scale), minimising (Squash), menus and popups, the blur behind glass.
scaleEnabled=true
squashEnabled=true
fadingpopupsEnabled=true
slidingpopupsEnabled=true
blurEnabled=true
contrastEnabled=true
maximizeEnabled=true
dialogparentEnabled=true
startupfeedbackEnabled=true

[ModifierOnlyShortcuts]
# The Super (Windows) key on its own opens Huginn's start menu.
Meta=org.huginn.Shell,/org/huginn/Shell,org.huginn.Shell,ToggleLauncher

[Round-Corners]
# Every window gets the same rounded corners as Huginn's own (the window radius of tokens.json).
Size=14
InactiveCornerRadius=14
# Square when they fill the screen (the bar turns solid then), and never on the desktop's own layers (the shell
# runs as python3, and its wallpaper, bar and dock are rounded or flat already).
DisableRoundMaximize=true
DisableRoundTile=true
Exclusions=python3
