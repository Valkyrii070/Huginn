# Lets Huginn's browser engine (Qt WebEngine, i.e. Chromium) set up its sandbox.
# Ubuntu blocks unprivileged user namespaces for programs without a profile; this profile leaves
# Huginn otherwise unconfined and only grants that. Same shape as the profiles Ubuntu ships for
# other browsers.
abi <abi/4.0>,
include <tunables/global>

profile huginn /usr/bin/huginn flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/huginn>
}
