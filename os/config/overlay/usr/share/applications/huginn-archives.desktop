[Desktop Entry]
Type=Application
Name=Archives
Comment=Open and unpack zip and tar files
Exec=python3 /usr/share/huginn-apps/huginn_app.py archives %f
Icon=huginn-archives
Categories=Utility;Archiving;
StartupWMClass=huginn-archives
MimeType=application/zip;application/x-tar;application/gzip;application/x-compressed-tar;application/x-xz-compressed-tar;application/x-bzip-compressed-tar;application/x-zstd-compressed-tar;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/vnd.ms-cab-compressed;application/x-cpio;application/x-xar;application/x-lha;
