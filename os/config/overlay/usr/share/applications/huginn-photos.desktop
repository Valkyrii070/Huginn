[Desktop Entry]
Type=Application
Name=Photos
Comment=Look through your pictures
Exec=python3 /usr/share/huginn-apps/huginn_app.py photos %f
Icon=huginn-photos
Categories=Graphics;Viewer;
StartupWMClass=huginn-photos
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/svg+xml;image/tiff;image/avif;image/heif;image/heic;image/jxl;image/x-icon;image/x-portable-pixmap;
