[Desktop Entry]
Type=Application
Name=Easel
GenericName=Image Editor
Comment=Paint, retouch and draw: pixel layers and vector layers in one picture
Exec=python3 /usr/share/huginn-apps/huginn_app.py easel %f
Icon=huginn-easel
Categories=Graphics;2DGraphics;RasterGraphics;VectorGraphics;
Keywords=paint;draw;photoshop;illustrator;image;editor;layers;vector;brush;svg;retouch;
MimeType=application/x-huginn-easel;image/openraster;image/png;image/jpeg;image/webp;image/tiff;image/bmp;image/svg+xml;
StartupWMClass=huginn-easel
