# Windows batch and PowerShell files need CRLF line endings to run reliably.
*.bat   text eol=crlf
*.ps1   text eol=crlf
README.txt text eol=crlf
*.py    text eol=lf
*.js    text eol=lf
*.md    text eol=lf
*.ico   binary
*.png   binary
*.mp4   binary
*.bdic  binary
*.zip   binary
*.sh       text eol=lf
*.command  text eol=lf

# Huginn OS's build kit (os/) is not part of the browser's download.
os/ export-ignore
*.qsb   binary
*.jpg   binary
